[0.688469, "o", "\r\n"]
[0.688511, "o", "  The pipeline (phases 4–8, deterministic)\r\n"]
[0.69176, "o", "──────────────────────────────────────────────────"]
[0.692155, "o", "\u001b[0m\r\n\u001b[2mGap detection → clarification → consolidation → contradictions → exports, over fixture extractions\u001b[0m\r\n"]
[0.6923, "o", "\r\n\u001b[35m$ uv run python3 scripts/demo_offline_build.py\u001b[0m\r\n"]
[0.988636, "o", "====================================================================================\r\nOFFLINE DETERMINISTIC PIPELINE (fixture extractions)\r\n====================================================================================\r\nchunks processed     : 5\r\nconsolidated vars    : 15\r\nconsolidated rels    : 10\r\nhypotheses           : 10\r\ngaps detected        : 10\r\nstructural coverage  : 0.50\r\ntestability          : 0.60\r\nclarification q's    : 10\r\n"]
[0.988721, "o", "contradictions       : 0 (0 unresolved)\r\n\r\nTOP GAPS\r\n  - [medium] Relationship references variables that are not defined in extracted variable lists: anxiety, micromanagement\r\n  - [medium] Relationship references variables that are not defined in extracted variable lists: anxiety, team support\r\n  - [medium] Relationship references variables that are not defined in extracted variable lists: communication clarity, uncertainty about priorities\r\n\r\nCLARIFICATION QUESTIONS (researcher-routed)\r\n  - Q1: Which exact constructs define these referenced variables and how should they be measured?\r\n  - Q10: Which exact constructs define these referenced variables and how should they be measured?\r\n  - Q2: Which exact constructs define these referenced variables and how should they be measured?\r\n\r\nMERGED MODEL SUMMARY\r\n  15 consolidated variables and 10 cross-chunk relationships were merged. Workload shows a positive link to Stress (confidence 0.48); Team support shows a negative link to Anxiety (confidence 0.47). 10 scored "]
[0.988835, "o", "hypotheses are ready for review.\r\n\r\nARTIFACTS WRITTEN TO outputs/demo/\r\n"]
[1.018313, "o", "\u001b[32m✓ All deterministic phases executed; artifacts written to outputs/demo/\u001b[0m\r\n\r\n"]
