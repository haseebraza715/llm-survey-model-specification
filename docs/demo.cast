[0.099636, "o", "\r\n"]
[0.099681, "o", "  Deterministic eval harness — the trip-wire\r\n"]
[0.104426, "o", "────────────────────────────────────────────────────"]
[0.104837, "o", "\u001b[0m\r\n"]
[0.104912, "o", "\u001b[2mOffline smoke over bundled fixtures; no API key, byte-for-byte reproducible\u001b[0m\r\n\r\n\u001b[35m$ uv run python3 scripts/smoke_offline.py\u001b[0m\r\n"]
[0.322696, "o", "{\"false_positives\": 1, \"gold_items\": 9, \"mode\": \"offline-fixture\", \"status\": \"ok\", \"true_positives_matched_gold\": 9}\r\n"]
[0.344039, "o", "\u001b[32m✓ Offline smoke passed\u001b[0m\r\n\r\n"]
[0.344065, "o", "\u001b[33m→ Recomputing precision / recall / F1 with 1000-resample bootstrap CIs…\u001b[0m\r\n"]
[0.679295, "o", "  metric      point     95% CI\r\n  precision     0.900   [0.700, 1.000]\r\n  recall        1.000   [1.000, 1.000]\r\n  f1            0.947   [0.824, 1.000]\r\n\r\n  gold items: 9   true positives: 9   false positives: 1\r\n  per-chunk variance: 5 chunks, F1 std 0.057\r\n"]
