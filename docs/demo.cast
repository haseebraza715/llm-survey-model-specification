[0.081481, "o", "\u001b[1m\u001b[36m"]
[0.08537, "o", "───────────────────────────────────────────────"]
[0.085719, "o", "\r\n  The input: a messy, open-ended survey\r\n"]
[0.088755, "o", "───────────────────────────────────────────────"]
[0.089024, "o", "\u001b[0m\r\n"]
[0.089091, "o", "\u001b[2mdata/raw/synthetic_workplace_survey.csv — 20 respondents, free-text answers\u001b[0m\r\n\r\n"]
[0.092437, "o", "\u001b[1mFirst two responses:\u001b[0m\r\n"]
[0.095987, "o", "respondent_1,\"I feel overwhelmed when I have too many deadlines at work. My manager doesn't provide clear guidance, which makes it worse. The lack of communication creates uncertainty about priorities.\",\r\n2024-01-15\r\n"]
