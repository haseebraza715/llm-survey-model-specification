[0.021885, "o", "\u001b[0m\r\n\u001b[1m  Qualitative survey text  ->  structured causal model\r\n  with quote-level provenance on every claim.\r\n\u001b[0m\r\n\u001b[2m  Reproducible research pipeline  •  8 phases  •  100% offline demo\r\n\u001b[0m\r\n\r\n\u001b[1m\u001b[36m"]
[0.025395, "o", "───────────────────────────"]
[0.025932, "o", "\r\n  Environment check\r\n"]
[0.029373, "o", "───────────────────────────"]
[0.029611, "o", "\u001b[0m\r\n"]
[0.029645, "o", "\u001b[2mRequires Python >= 3.10 and uv (https://docs.astral.sh/uv/)\u001b[0m\r\n\r\n"]
[0.039455, "o", "\u001b[32m✓ uv 0.10.12 found\u001b[0m\r\n"]
[0.03958, "o", "\u001b[33m→ Syncing locked environment into .venv (offline if already cached)…\u001b[0m\r\n\u001b[35m$ uv sync --extra dev --quiet\u001b[0m\r\n"]
